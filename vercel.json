{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --workspace @maos/web",
  "installCommand": "npm ci",
  "functions": {
    "api/control-room.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/control-room"
    }
  ]
}
